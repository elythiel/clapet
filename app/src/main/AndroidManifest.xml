<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A launcher must see every launchable app (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".ClapetApplication"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clapet">

        <!-- Read by HyperOS (BoundsCompatUtils, miui-services): 0 = full cover screen
             (1208 × 1392) instead of the scaled-down compatibility mode. Set on every
             activity, since the launch activity measures the window too. -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="miui.supportFlipFullScreen"
                android:value="0" />
        </activity>

        <!-- Folding and unfolding change the configuration: handled in Compose, not by
             recreating the activity. -->
        <activity
            android:name=".home.HomeActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="xyz.martelle.clapet.home"
            android:theme="@style/Theme.Clapet.Home">
            <meta-data
                android:name="miui.supportFlipFullScreen"
                android:value="0" />
            <!-- Read by FlipLauncher (PackageManager.getProperty): false hides its widget square. -->
            <property
                android:name="miui.supportFlipWatchOverlayGroupView"
                android:value="false" />
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:resizeableActivity="true">
            <meta-data
                android:name="miui.supportFlipFullScreen"
                android:value="0" />
            <property
                android:name="miui.supportFlipWatchOverlayGroupView"
                android:value="false" />
        </activity>
    </application>

</manifest>
