<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cover-screen allow list (window dump command). A development permission, granted
         once through Shizuku or `adb shell pm grant`; it survives reboots. -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <!-- The allow list must include every package, not only launcher apps: system screens
         opened by apps (photo picker, permission prompts) are refused on the cover otherwise. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Lets the "Keep Clapet running" screen open Android's battery prompt for Clapet. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The allow list is lost at every reboot and replayed at boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Upcoming events in the home header (milestone 6), asked from the health page. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Required by the clock app (Xiaomi's included) to show its alarms, from the header's date. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- A launcher must see every launchable app (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".ClapetApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clapet">

        <!-- Read by HyperOS (BoundsCompatUtils, miui-services): 0 = full cover screen
             (1208 × 1392) instead of the scaled-down compatibility mode. Set on every
             activity, since the launch activity measures the window too. -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="miui.supportFlipFullScreen"
                android:value="0" />
        </activity>

        <!-- Folding and unfolding change the configuration: handled in Compose, not by
             recreating the activity. -->
        <activity
            android:name=".home.HomeActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="xyz.martelle.clapet.home"
            android:theme="@style/Theme.Clapet.Home"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="miui.supportFlipFullScreen"
                android:value="0" />
            <!-- Read by FlipLauncher (PackageManager.getProperty): false hides its widget square. -->
            <property
                android:name="miui.supportFlipWatchOverlayGroupView"
                android:value="false" />
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:resizeableActivity="true">
            <meta-data
                android:name="miui.supportFlipFullScreen"
                android:value="0" />
            <property
                android:name="miui.supportFlipWatchOverlayGroupView"
                android:value="false" />
        </activity>

        <!-- Bound by the system only (BIND_ACCESSIBILITY_SERVICE); not reachable by other apps. -->
        <service
            android:name=".pseudohome.CoverHomeService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/cover_home_service" />
        </service>

        <!-- Bound by the system once notification access is granted (BIND_NOTIFICATION_LISTENER_SERVICE):
             notifications under the apps, and the media sessions for the cover player. -->
        <service
            android:name=".notifications.ClapetNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Protected system broadcasts only: exported, but no app can send them. -->
        <receiver
            android:name=".unlock.UnlockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku hands its binder to Clapet through this provider (as its documentation requires). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
